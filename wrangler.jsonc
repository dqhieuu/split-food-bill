{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "split-food-bill",
	"workers_dev": true,
	"main": "worker/src/index.ts",
	"compatibility_date": "2026-10-26",
	"durable_objects": { "bindings": [{ "name": "AUTH_SESSIONS", "class_name": "AuthSessions" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthSessions"] }],
	"r2_buckets": [{ "binding": "BILL_IMAGES", "bucket_name": "split-food-bill-images" }],
	"vars": {
		"APP_ENV": "production",
		"FRONTEND_ORIGIN": "https://anthitcho.vercel.app",
		"FIREBASE_PROJECT_ID": "split-food-bill",
		"FIREBASE_API_KEY": "AIzaSyB_sNBJhIGuvqpKFQTzs7ReRVxoMsmOxbA",
		"FIREBASE_AUTH_DOMAIN": "split-food-bill.firebaseapp.com"
	},
	"env": {
		"local": {
			"name": "split-food-bill-api-local",
			"durable_objects": { "bindings": [{ "name": "AUTH_SESSIONS", "class_name": "AuthSessions" }] },
			"r2_buckets": [{ "binding": "BILL_IMAGES", "bucket_name": "split-food-bill-images-local" }],
			"vars": {
				"APP_ENV": "local",
				"FRONTEND_ORIGIN": "http://127.0.0.1:5173",
				"FIREBASE_PROJECT_ID": "demo-lunchroom",
				"FIREBASE_API_KEY": "demo-lunchroom-key",
				"FIREBASE_AUTH_DOMAIN": "localhost",
				"FIRESTORE_EMULATOR_HOST": "127.0.0.1:8080",
				"FIREBASE_AUTH_EMULATOR_HOST": "127.0.0.1:9099",
				"DISCORD_ADMIN_IDS": "100000000000000001"
			}
		}
	}
}
