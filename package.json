{
	"name": "bill-splitting",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:web": "vite --host 127.0.0.1",
		"emulators": "node scripts/dev.mjs --emulators-only",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:supabase": "vitest run --config vitest.supabase.config.ts",
		"test:e2e": "playwright test",
		"format": "prettier --write .",
		"backup:local": "node scripts/backup.mjs",
		"restore:local": "node --import tsx scripts/restore-local.mjs",
		"migrate:supabase": "node --import tsx scripts/migrate-supabase.ts",
		"dev:worker": "wrangler dev --env local --ip 127.0.0.1 --port 8787",
		"check:worker": "tsc -p worker/tsconfig.json",
		"build:worker": "wrangler deploy --dry-run --outdir artifacts/worker-build",
		"deploy:worker": "wrangler deploy",
		"seed:local": "node --import tsx scripts/seed-local.mjs"
	},
	"dependencies": {
		"@lucide/svelte": "^1.72.0",
		"@use-gesture/vanilla": "^10.3.1",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"firebase": "^13.2.0",
		"firebase-admin": "^14.5.0",
		"jose": "^6.2.17",
		"pg": "^8.23.1",
		"qrcode": "^1.5.4",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"three": "^0.187.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261110.1",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/adapter-vercel": "^7.0.3",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22.20.5",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "^1.5.6",
		"@types/three": "^0.187.0",
		"firebase-tools": "^15.35.0",
		"prettier": "^3.10.0",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"wrangler": "^4.160.1"
	},
	"engines": {
		"node": ">=22.17.0"
	}
}
