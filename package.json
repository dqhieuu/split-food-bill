{
	"name": "lunchroom",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:web": "vite --host 127.0.0.1",
		"emulators": "node scripts/dev.mjs --emulators-only",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"format": "prettier --write .",
		"backup:local": "node scripts/backup.mjs"
	},
	"dependencies": {
		"@lucide/svelte": "^1.61.0",
		"bits-ui": "^2.20.2",
		"clsx": "latest",
		"firebase": "latest",
		"firebase-admin": "latest",
		"qrcode": "^1.5.4",
		"tailwind-merge": "latest",
		"tailwind-variants": "^3.3.1",
		"zod": "latest"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "latest",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "latest",
		"@tailwindcss/vite": "latest",
		"@types/node": "latest",
		"@types/qrcode": "^1.5.6",
		"firebase-tools": "^15.34.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "latest",
		"tailwindcss": "latest",
		"tw-animate-css": "latest",
		"typescript": "latest",
		"vite": "^8.3.5",
		"vitest": "latest"
	},
	"overrides": {
		"@grpc/grpc-js": "^1.14.6",
		"@opentelemetry/core": "^2.12.0",
		"gaxios": {
			"uuid": "^11.1.1"
		}
	},
	"engines": {
		"node": ">=22.17.0"
	}
}
