{
	"name": "lunchroom",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "npm@11.19.1",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:web": "vite --host 127.0.0.1",
		"emulators": "node scripts/dev.mjs --emulators-only",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:supabase": "vitest run --config vitest.supabase.config.ts",
		"test:e2e": "playwright test",
		"format": "prettier --write .",
		"backup:local": "node scripts/backup.mjs",
		"restore:local": "node --import tsx scripts/restore-local.mjs",
		"migrate:supabase": "node --import tsx scripts/migrate-supabase.ts",
		"dev:worker": "wrangler dev --env local --ip 127.0.0.1 --port 8787",
		"check:worker": "tsc -p worker/tsconfig.json",
		"build:worker": "wrangler deploy --dry-run --outdir artifacts/worker-build",
		"deploy:worker": "wrangler deploy",
		"seed:local": "node --import tsx scripts/seed-local.mjs"
	},
	"dependencies": {
		"@lucide/svelte": "^1.66.0",
		"@use-gesture/vanilla": "^10.3.1",
		"bits-ui": "^2.20.2",
		"clsx": "latest",
		"firebase": "latest",
		"firebase-admin": "latest",
		"jose": "^6.2.14",
		"pg": "^8.23.1",
		"qrcode": "^1.5.4",
		"tailwind-merge": "latest",
		"tailwind-variants": "^4.0.1",
		"three": "^0.187.0",
		"zod": "latest"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261101.1",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "latest",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/adapter-vercel": "^7.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "latest",
		"@tailwindcss/vite": "latest",
		"@types/node": "latest",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "^1.5.6",
		"@types/three": "^0.187.0",
		"firebase-tools": "^15.34.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "latest",
		"tailwindcss": "latest",
		"tsx": "^4.23.15",
		"tw-animate-css": "latest",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "latest",
		"wrangler": "^4.156.0"
	},
	"overrides": {
		"@grpc/grpc-js": "^1.14.6",
		"@opentelemetry/core": "^2.12.0",
		"gaxios": {
			"uuid": "^11.1.1"
		}
	},
	"engines": {
		"node": ">=22.17.0"
	}
}
